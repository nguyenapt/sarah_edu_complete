{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase1TopicSegmentation",
  "type": "object",
  "required": ["exerciseTopics", "questionTopics"],
  "additionalProperties": false,
  "properties": {
    "exerciseTopics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "questionTopics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "topicId"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "topicId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
