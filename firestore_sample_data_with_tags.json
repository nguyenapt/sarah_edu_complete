    "exercise_word_formation_sample": {
      "lessonId": "lesson_a1_1_1",
      "unitId": "unit_a1_1",
      "levelId": "A1",
      "type": "word_formation_exercise",
      "question": {
        "en": "Fill in the blank with the correct form of the word",
        "vi": "Điền vào chỗ trống với dạng đúng của từ"
      },
      "content": {
        "sentence": {
          "en": "She showed great _____ (create) in her artwork.",
          "vi": "Cô ấy thể hiện sự _____ (sáng tạo) lớn trong tác phẩm nghệ thuật của mình."
        },
        "baseWord": "create",
        "correctForm": "creativity",
        "options": [
          "create",
          "creative",
          "creativity",
          "creatively"
        ],
        "explanation": {
          "en": "We need a noun form here. 'Create' is a verb, 'creative' is an adjective, 'creativity' is a noun, and 'creatively' is an adverb.",
          "vi": "Chúng ta cần dạng danh từ ở đây. 'Create' là động từ, 'creative' là tính từ, 'creativity' là danh từ, và 'creatively' là trạng từ."
        }
      },
      "points": 10,
      "difficulty": "medium",
      "explanation": {
        "en": "Use the correct word form based on the sentence structure",
        "vi": "Sử dụng dạng từ đúng dựa trên cấu trúc câu"
      },
      "skillTypes": [
        "writing"
      ],
      "grammarTopics": [
        "present_simple"
      ]
    },
