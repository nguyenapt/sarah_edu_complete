      "content": {
        "title": {
          "en": "Present Simple - Affirmative",
          "vi": "Thì hiện tại đơn - Câu khẳng định"
        },
        "description": {
          "en": "<p>The present simple is used to describe habits, facts, and general truths.</p>",
          "vi": "<p>Thì hiện tại đơn được dùng để mô tả thói quen, sự thật và chân lý chung.</p>"
        }
      }
